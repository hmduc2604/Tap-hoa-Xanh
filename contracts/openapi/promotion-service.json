  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT do auth-service phát hành, kiểm tra tại API Gateway"
      },
      "internalToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Token",
        "description": "Khóa nội bộ cho lời gọi service-to-service"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "OUT_OF_STOCK"
              },
              "message": {
                "type": "string",
                "example": "Không đủ hàng: Pate gan Hạ Long 150g (còn 0)"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        }
      }
    },
    "responses": {
      "ClientError": {
        "description": "Lỗi phía client (400, 401, 403, 404, 409...)",
        "content": {
          "application/json": {
            "schema": {
