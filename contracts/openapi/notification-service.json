{
  "openapi": "3.0.3",
  "info": {
    "title": "notification-service — hợp đồng dịch vụ",
    "version": "1.0.0",
    "description": "Thông báo trong ứng dụng và email, chỉ lắng nghe sự kiện",
    "x-service-name": "notification-service",
    "x-service-layer": "utility"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "notifications"
    },
    {
      "name": "operations"
    }
  ],
  "paths": {
    "/api/notifications": {
      "get": {
        "operationId": "list_notifications",
        "summary": "Thông báo của tôi (nhân viên thấy thêm thông báo chung)",
        "tags": [
          "notifications"
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/ClientError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-access": "authenticated"
      }
    },
    "/api/notifications/{nid}/read": {
      "put": {
        "operationId": "mark_read",
        "summary": "Đánh dấu một thông báo đã đọc",
        "tags": [
          "notifications"
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/ClientError"
          }
        },
        "parameters": [
          {
            "name": "nid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-access": "authenticated"
      }
    },
    "/api/notifications/emails": {
      "get": {
        "operationId": "email_logs",
        "summary": "Nhật ký email đã gửi (mô phỏng)",
        "tags": [
          "notifications"
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/ClientError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-access": "roles:admin",
        "description": "Vai trò được phép: admin"
      }
    },
    "/api/notifications/read-all": {
      "put": {
        "operationId": "mark_all_read",
        "summary": "Đánh dấu đã đọc tất cả",
        "tags": [
          "notifications"
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/ClientError"
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-access": "authenticated"
      }
    },
    "/api/notifications/unread-count": {
      "get": {
        "operationId": "unread_count",
        "summary": "Số thông báo chưa đọc",
        "tags": [
          "notifications"
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/ClientError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-access": "authenticated"
      }
    },
    "/contract": {
      "get": {
        "operationId": "_contract",
        "summary": "Hợp đồng dịch vụ OpenAPI 3 (?public=1 để bỏ các API nội bộ)",
        "tags": [
          "operations"
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/ClientError"
          }
        },
        "security": [],
        "x-access": "public"
      }
    },
    "/health": {
      "get": {
        "operationId": "_health",
        "summary": "Kiểm tra trạng thái service và kết nối CSDL",
        "tags": [
          "operations"
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/ClientError"
          }
        },
        "security": [],
        "x-access": "public"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT do auth-service phát hành, kiểm tra tại API Gateway"
      },
      "internalToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Token",
        "description": "Khóa nội bộ cho lời gọi service-to-service"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "OUT_OF_STOCK"
              },
              "message": {
                "type": "string",
                "example": "Không đủ hàng: Pate gan Hạ Long 150g (còn 0)"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        }
      }
    },
    "responses": {
      "ClientError": {
        "description": "Lỗi phía client (400, 401, 403, 404, 409...)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
