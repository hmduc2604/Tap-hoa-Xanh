<?xml version="1.0" encoding="utf-8"?>
<wsdl:definitions name="CatalogService" targetNamespace="urn:taphoaxanh:catalog:v1"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="urn:taphoaxanh:catalog:v1">
  <wsdl:documentation>Dịch vụ tra cứu danh mục sản phẩm Tạp Hóa Xanh (SOAP 1.1, document/literal). ESB tại API Gateway chuyển tiếp tới product-service REST.</wsdl:documentation>
  <wsdl:types>
    <xsd:schema targetNamespace="urn:taphoaxanh:catalog:v1" elementFormDefault="qualified" xmlns:tns="urn:taphoaxanh:catalog:v1">
      <xsd:complexType name="Category">
        <xsd:sequence>
          <xsd:element name="id" type="xsd:int"/>
          <xsd:element name="name" type="xsd:string"/>
          <xsd:element name="icon" type="xsd:string" minOccurs="0"/>
          <xsd:element name="productCount" type="xsd:int"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="Product">
        <xsd:sequence>
          <xsd:element name="id" type="xsd:int"/>
          <xsd:element name="sku" type="xsd:string"/>
          <xsd:element name="name" type="xsd:string"/>
          <xsd:element name="category" type="xsd:string"/>
          <xsd:element name="unit" type="xsd:string"/>
          <xsd:element name="price" type="xsd:long"/>
          <xsd:element name="salePrice" type="xsd:long" minOccurs="0"/>
          <xsd:element name="finalPrice" type="xsd:long"/>
          <xsd:element name="available" type="xsd:int" minOccurs="0"/>
          <xsd:element name="rating" type="xsd:decimal"/>
          <xsd:element name="brand" type="xsd:string" minOccurs="0"/>
          <xsd:element name="barcode" type="xsd:string" minOccurs="0"/>
          <xsd:element name="description" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:element name="GetCategories"><xsd:complexType><xsd:sequence/></xsd:complexType></xsd:element>
      <xsd:element name="GetCategoriesResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="Category" type="tns:Category" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="SearchProducts">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="keyword" type="xsd:string" minOccurs="0"/>
          <xsd:element name="categoryId" type="xsd:int" minOccurs="0"/>
          <xsd:element name="page" type="xsd:int" minOccurs="0"/>
          <xsd:element name="pageSize" type="xsd:int" minOccurs="0"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="SearchProductsResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="total" type="xsd:int"/>
          <xsd:element name="page" type="xsd:int"/>
          <xsd:element name="totalPages" type="xsd:int"/>
          <xsd:element name="Product" type="tns:Product" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="GetProduct">
        <xsd:complexType><xsd:sequence><xsd:element name="productId" type="xsd:int"/></xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="GetProductResponse">
        <xsd:complexType><xsd:sequence><xsd:element name="Product" type="tns:Product"/></xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="ErrorDetail">
        <xsd:complexType><xsd:sequence><xsd:element name="code" type="xsd:string"/></xsd:sequence></xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </wsdl:types>
  <wsdl:message name="GetCategoriesInput"><wsdl:part name="parameters" element="tns:GetCategories"/></wsdl:message>
  <wsdl:message name="GetCategoriesOutput"><wsdl:part name="parameters" element="tns:GetCategoriesResponse"/></wsdl:message>
  <wsdl:message name="SearchProductsInput"><wsdl:part name="parameters" element="tns:SearchProducts"/></wsdl:message>
  <wsdl:message name="SearchProductsOutput"><wsdl:part name="parameters" element="tns:SearchProductsResponse"/></wsdl:message>
  <wsdl:message name="GetProductInput"><wsdl:part name="parameters" element="tns:GetProduct"/></wsdl:message>
  <wsdl:message name="GetProductOutput"><wsdl:part name="parameters" element="tns:GetProductResponse"/></wsdl:message>
  <wsdl:portType name="CatalogPortType">
    <wsdl:operation name="GetCategories">
      <wsdl:input message="tns:GetCategoriesInput"/>
      <wsdl:output message="tns:GetCategoriesOutput"/>
    </wsdl:operation>
    <wsdl:operation name="SearchProducts">
      <wsdl:input message="tns:SearchProductsInput"/>
      <wsdl:output message="tns:SearchProductsOutput"/>
    </wsdl:operation>
    <wsdl:operation name="GetProduct">
      <wsdl:input message="tns:GetProductInput"/>
      <wsdl:output message="tns:GetProductOutput"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="CatalogSoapBinding" type="tns:CatalogPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="GetCategories">
      <soap:operation soapAction="urn:taphoaxanh:catalog:v1#GetCategories"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="SearchProducts">
      <soap:operation soapAction="urn:taphoaxanh:catalog:v1#SearchProducts"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="GetProduct">
      <soap:operation soapAction="urn:taphoaxanh:catalog:v1#GetProduct"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="CatalogService">
    <wsdl:port name="CatalogPort" binding="tns:CatalogSoapBinding">
      <soap:address location="http://localhost:8080/api/soap/catalog"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
