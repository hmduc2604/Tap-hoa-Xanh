# Sao chép thành .env rồi đổi giá trị trước khi triển khai thật
JWT_SECRET=change-me-in-production-jwt-secret
INTERNAL_API_KEY=change-me-internal-service-key
POSTGRES_PASSWORD=grocery
RABBITMQ_PASSWORD=grocery
# Cổng mở ra máy (đổi nếu bị trùng với ứng dụng khác)
WEB_PORT=8080
GATEWAY_PORT=8000
POSTGRES_PORT=5433
RABBITMQ_UI_PORT=15672
# Tính năng AI. AI_ENGINE=local (mặc định): dùng mô hình tự huấn luyện trong ml/, chạy trong service, không cần khóa.
# AI_ENGINE=llm: gọi mô hình ngôn ngữ bên ngoài, cần AI_API_KEY (thiếu khóa thì tự dùng local). KHÔNG đưa khóa thật lên git.
# Hỗ trợ Google Gemini (khuyến nghị, tự nhận qua tên model) và Anthropic. Khi API lỗi/bận, trợ lý tự chuyển sang mô hình cục bộ.
AI_ENGINE=local
AI_API_KEY=
# AI_PROVIDER=gemini                      # gemini | anthropic (bỏ trống = tự nhận)
# AI_MODEL=gemini-3-flash-preview         # mặc định theo nhà cung cấp; Anthropic: claude-haiku-5-5
# AI_FALLBACK_MODELS=gemini-3.1-flash-lite  # thử lần lượt khi model chính báo bận
# AI_THINKING=low                         # mức suy nghĩ của Gemini 3 (minimal|low|medium|high|off): thấp = nhanh hơn, cao = kỹ hơn
